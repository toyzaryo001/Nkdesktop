{
  "name": "nk-helper-desktop",
  "version": "3.8.38",
  "description": "NK BackOffice Helper — Enterprise Desktop App",
  "main": "main/main.js",
  "author": "NK Helper Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "electron-store": "8.2.0",
    "exceljs": "4.4.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.nkhelper.desktop",
    "productName": "NK Helper",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NK Helper",
      "include": "build/installer.nsh"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "preload.js"
    ]
  }
}
